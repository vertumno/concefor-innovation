{
  "name": "concefor-app",
  "version": "0.1.0",
  "private": true,
  "description": "PWA do VIII Concefor — programação, reações ao vivo no telão e relatório",
  "scripts": {
    "dev": "next dev",
    "dev:demo": "cross-env NEXT_PUBLIC_DEMO=1 next dev",
    "build": "cross-env SYNC_INTERVAL_MIN=0 next build",
    "build:demo": "cross-env NEXT_PUBLIC_DEMO=1 SYNC_INTERVAL_MIN=0 next build",
    "test": "tsx --test src/**/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "start": "next start",
    "seed": "node scripts/seed.mjs",
    "sync:even3": "node scripts/sync-even3.mjs",
    "seed:live": "node scripts/seed-live.mjs",
    "seed:validacao": "node scripts/seed-validacao.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:qa": "node scripts/seed-qa.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "jsqr": "^1.4.0",
    "next": "15.5.23",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.23.11",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
